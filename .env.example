# Copy this file to .env (or otherwise set these in your shell/deployment
# environment) and fill in real values. Never commit the real .env file.

# Secret, application-wide value mixed into every password hash alongside
# each user's per-row salt. Must be set before the server hashes or
# verifies any password - the process refuses to start hashing without it.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
KUNGFU_CHESS_PASSWORD_PEPPER=